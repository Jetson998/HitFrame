# ---- API ----
PORT=3001
# M1 最小访问边界：前端请求需带 Authorization: Bearer <API_TOKEN>
API_TOKEN=dev-token-change-me
DATABASE_URL=postgres://hitframe:hitframe@localhost:5432/hitframe
# StorageAdapter（M1 本地 Volume）；对象键 {projectId}/{runId}/{jobId}.{ext}
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:3001

# ---- Image Provider（密钥只存服务端，永不下发前端）----
IMAGE_PROVIDER=muskapis
IMAGE_BASE_URL=https://api.muskapis.com/v1
IMAGE_MODEL=gpt-image-2
IMAGE_API_KEY=

# ---- M2a S2 执行内核（互斥开关：queue | inline；禁止双内核同时消费）----
EXECUTION_MODE=queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
WORKER_CONCURRENCY=2
EXECUTOR_CONCURRENCY=2
