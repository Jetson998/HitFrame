# ---- API ----
PORT=3001
# M1 最小访问边界：前端请求需带 Authorization: Bearer <API_TOKEN>
API_TOKEN=dev-token-change-me
DATABASE_URL=postgres://hitframe:hitframe@localhost:5432/hitframe
# StorageAdapter（ADR-9）；对象键 {projectId}/{runId}/{jobId}.{ext}
# STORAGE_DRIVER=local：本地 Volume（默认，开发/回滚）；=s3：对象存储
STORAGE_DRIVER=local
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:3001
# 稳定网关 URL /files/{key} 命中 s3 时签发的签名时效（秒）；每次访问即时刷新
SIGNED_URL_TTL=900

# ---- S3 兼容对象存储（STORAGE_DRIVER=s3 时生效）----
# 本地 SeaweedFS：endpoint=http://127.0.0.1:8333；生产换客户 OSS 仅改这几项
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=hitframe
S3_ACCESS_KEY=hitframe-dev
S3_SECRET_KEY=hitframe-dev-secret
# SeaweedFS/MinIO 需 path-style；AWS S3 可设 false 走 virtual-host
S3_FORCE_PATH_STYLE=true

# ---- Image Provider（密钥只存服务端，永不下发前端）----
IMAGE_PROVIDER=muskapis
IMAGE_BASE_URL=https://api.muskapis.com/v1
IMAGE_MODEL=gpt-image-2
IMAGE_API_KEY=

# ---- Agent 提示词编译器（默认复用中转站地址与密钥）----
# 未单独填写 BASE_URL / API_KEY 时复用 IMAGE_BASE_URL / IMAGE_API_KEY。
PROMPT_COMPILER_PROVIDER=openai_compatible
PROMPT_COMPILER_MODEL=gpt-5.6-sol
PROMPT_COMPILER_TIMEOUT_MS=60000

# ---- M2a S2 执行内核（互斥开关：queue | inline；禁止双内核同时消费）----
EXECUTION_MODE=queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
WORKER_CONCURRENCY=2
EXECUTOR_CONCURRENCY=2
